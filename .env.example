# 이 파일을 .env로 복사해 값을 채운다. .env는 절대 커밋하지 않는다.
# 참조 구현(prototype/)에서만 쓴다. Make 시나리오에서는 이 값들을
# Connection에 저장하며 모듈에 직접 입력하지 않는다 (NFR-06).
#
# PowerShell에서 한 세션 동안만 쓰려면:
#   $env:GEMINI_API_KEY = "..."

# Google AI Studio에서 발급. 결제(billing)는 켜지 말 것 (PRD 8.2).
GEMINI_API_KEY=

# Notion 통합의 Internal Integration Secret. ntn_ 으로 시작한다.
NOTION_TOKEN=

# DB 주소의 ?v= 앞 32자리.
NOTION_DATABASE_ID=
